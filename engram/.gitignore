# Real config — machine paths + secrets. Copy config/application_settings.example.json to create it.
config/application_settings.json

# Eval runtime artifacts (transient queue state — NOT source). The golden datasets
# (evals/datasets/) and saved RCA SQL (evals/rca/) ARE source and stay tracked.
evals/bridge/
evals/pending_pages*.json
# Datasets imported from a benchmark dataset's relevance judgments carry its query text under its own license.
# Rebuild them with `studio evals import-judgments`, never commit them.
evals/datasets/scifact*
evals/datasets/nfcorpus*
evals/datasets/multihop-rag*
# Benchmark run outputs: per-case answers with citations, run logs and attempt folders. The compare reports
# committed beside them (compare.*, compare-a0-b.*) stay tracked.
evals/scores/multihop-rag/*.jsonl
evals/scores/multihop-rag/*.log
evals/scores/multihop-rag/attempts/
evals/scores/multihop-rag/trial1/
evals/scores/multihop-rag/compare-chunks.*

# Compiled corpus exports (OKF bundles) — generated by `studio export`, stamped
# `generated: by: engram/...`. Regenerable, not source; never committed.
bundles/
