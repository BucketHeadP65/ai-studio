{
  "name": "client-core",
  "private": true,
  "version": "0.0.13",
  "license": "MIT",
  "description": "App-agnostic frontend building blocks for studio-client/ — typed fetch wrapper + zod boundary, ui primitives, utilities, and the Vitest/MSW test-support harness. Raw TypeScript, consumed via file: deps + Next transpilePackages. No build step.",
  "type": "module",
  "files": [
    "src",
    "tsconfig.base.json",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "exports": {
    "./api/client": "./src/api/client.ts",
    "./lib/cn": "./src/lib/cn.ts",
    "./lib/format-relative": "./src/lib/format-relative.ts",
    "./test-support/render": "./src/test-support/render.tsx",
    "./test-support/setup": "./src/test-support/setup.ts",
    "./ui/badge": "./src/ui/badge.tsx",
    "./ui/button": "./src/ui/button.tsx",
    "./ui/card": "./src/ui/card.tsx",
    "./ui/confirm-dialog": "./src/ui/confirm-dialog.tsx",
    "./ui/drawer": "./src/ui/drawer.tsx",
    "./ui/empty-state": "./src/ui/empty-state.tsx",
    "./ui/input": "./src/ui/input.tsx",
    "./ui/modal": "./src/ui/modal.tsx",
    "./ui/section-header": "./src/ui/section-header.tsx",
    "./ui/select": "./src/ui/select.tsx",
    "./ui/status-dot": "./src/ui/status-dot.tsx",
    "./ui/textarea": "./src/ui/textarea.tsx"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "biome check --write src",
    "lint": "biome check src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.104.3",
    "next": "^16.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "radix-ui": "^1.8.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tanstack/react-query": "^5.104.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.0.1",
    "msw": "^3.0.3",
    "next": "^16.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.0.16",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "overrides": {
    "jsdom": {
      "undici": "~8.11.2"
    }
  }
}
