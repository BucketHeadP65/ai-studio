{
  "version": "1",
  "slug": "workflows",
  "purpose": "A store of workflow artifacts: procedures that have been run, checked, and kept. One page per versioned artifact, written as data through `engram ingest` (no vault compile) -- applicability prose in its own section so it is searchable, the executable spec carried in frontmatter as a document, trust earned rather than asserted. The store answers one question well: given this task, which stored procedure fits, and how far do we trust it?",
  "slug_conventions": "One page per artifact, kebab-case, unversioned in the slug (`quarterly-report`, not `quarterly-report-v3`); the version lives in frontmatter and supersession links the lineage.",
  "page_types": [
    {
      "id_prefix": "wf.",
      "folder": "workflows",
      "frontmatter_fields": [
        {
          "name": "workflow_version",
          "type": "int",
          "required": true
        },
        {
          "name": "requires",
          "type": "scalar-list"
        },
        {
          "name": "composes",
          "type": "link-list"
        }
      ],
